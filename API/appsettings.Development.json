{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.MSSqlServer"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "MSSqlServer",
        "Args": {
          "connectionString": "Server=LAPTOP-I0R4OA4K\\MYSQLSERVER;Database=BookingDb;Trusted_Connection=True;TrustServerCertificate=True;",
          "tableName": "Logs",
          "schemaName": "Logging",
          "autoCreateSqlTable": true,
          "restrictedToMinimumLevel": "Information"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "APP.Api"
    }
  },

  "ConnectionStrings": {
    "DefaultConnection": "Server=LAPTOP-I0R4OA4K\\MYSQLSERVER;Database=BookingDb;Trusted_Connection=true;TrustServerCertificate=true;"
  },

  "AppSettings": {
    "BaseUrl": "https://localhost:7225/",
    "FrontEndUrl": "",
    "ResetPasswordUrl": "https://localhost:7225/reset-password"
  },
  "BookingSettings": {
    "WorkingStart": "09:00",
    "WorkingEnd": "17:00",
    "SlotIntervalMinutes": 15,
    "TimeZoneId": "Africa/Cairo"
  }
}
